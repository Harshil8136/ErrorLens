# Copy to worker/.dev.vars and fill in. .dev.vars is gitignored.
#
# Every one of these is optional locally. The app degrades rather than breaks:
#   - no GEMINI_API_KEY      -> falls through to Workers AI, then the catalog
#   - no ADMIN_TOKEN         -> /api/admin/* returns 503 instead of falling open
#   - no IP_HASH_SALT        -> a development default is used (do not ship that)
#   - no TURNSTILE_SECRET_KEY-> bot verification is skipped entirely

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gates /api/admin/*.  Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Salts client IPs before storage.  Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Only needed if you also set TURNSTILE_SITE_KEY in wrangler.jsonc.
# Pair it with TURNSTILE_HOSTNAMES=localhost for local testing.
TURNSTILE_SECRET_KEY=
